# 复制为 .env 后填入真实 Key（.env 已在 .gitignore 外？注意别提交 Key）
# 获取方式：打开 https://opencode.ai/auth 登录 -> 复制 API Key
OPENCODE_API_KEY=
# 后端选择：local=本地llama（默认），cloud=云免费模型，auto=有Key用云否则本地
CAI_LLM=cloud
# 默认云模型（免费）：muse-spark-1.3-contributor-free，也可换 mimo-v2.5-free
OPENCODE_MODEL=muse-spark-1.3-contributor-free
